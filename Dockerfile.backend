# Этап сборки
FROM node:24-alpine AS builder
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci
COPY backend/ .
RUN npm run build

# Продакшн
FROM node:24-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev

# Шаблоны государственного производственного календаря и команда их заливки.
# Данные публичные (постановления Правительства РФ), но без них в контейнере
# нечем залить таблицу calendar_state_production: `npm run seed:calendar`
# читает seed/calendar/ru-YYYY.json. Скрипт использует только `pg` —
# зависимость рантайма, поэтому работает и без dev-зависимостей.
COPY --from=builder /app/seed ./seed
COPY --from=builder /app/scripts ./scripts

# Каталог для загруженных файлов (аватарки). В прод-стеке сюда монтируется
# том ph_uploads.
#
# Почему обязательно создать его ЗДЕСЬ, а не при старте приложения:
# named volume Docker инициализирует содержимым образа вместе с владельцем.
# Если каталога в образе нет, Docker создаст его сам — от root, — а процесс
# работает под непривилегированным `node` и получит EACCES на первую же
# запись. Права в образе действуют только в момент создания тома: у уже
# существующего тома владелец свой, его правит только chown на сервере.
RUN mkdir -p /app/uploads && chown node:node /app/uploads

USER node
EXPOSE 3000
CMD ["node", "dist/main"]