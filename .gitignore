# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Editor
# Именно **/.vscode/*, а не .vscode/: шаблон с «/» на конце исключает
# сам каталог, а тогда исключение !.vscode/extensions.json во
# frontend/.gitignore перестаёт работать — gitignore не умеет
# раз-игнорировать файл внутри исключённого каталога.
**/.vscode/*
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# SSH
known_hosts

# Локальные dev-инструменты: живут только на машине разработчика
# и переносятся на новое место вручную. В репозитории их нет.
# ВАЖНО: gitignore НЕ действует на уже отслеживаемые файлы —
# если файл успел попасть в индекс, нужен `git rm --cached`.
sync-db.bat
sync-db.example.bat
start-work.bat
end-work.bat
backups/
# docs/ — документация проекта, она в репозитории. Прочие файлы в docs/
# (например, личная шпаргалка .docx) остаются локальными.
# Именно docs/* (а не docs/), иначе исключение ниже не сработает:
# gitignore не умеет «раз-игнорировать» файл внутри исключённого каталога.
docs/*
!docs/*.md

# Локальные секреты и мусор (cookie-джар curl, дампы ответов и т.п.)
cookies.txt
*.cookies.txt
*.dump
*.sql
*.sql.gz
*.bak

# Ключи и сертификаты — в репозиторий не попадают никогда
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*