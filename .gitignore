# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Загруженные пользователями файлы (аватарки и т.п.).
# В проде и dev это отдельный docker-том, а не каталог в рабочей копии.
# Правило нужно как страховка: в dev каталог backend смонтирован в /app,
# и без этой строки залитая аватарка однажды уехала бы в коммит.
uploads/
# Каталог e2e-тестов бэкенда: туда пишутся тестовые аватарки,
# чтобы не трогать боевое хранилище.
.tmp-e2e-uploads/
# Временные каталоги для локальных проверок: скриншоты headless-браузера
# и его профили. Chrome держит профиль открытым, пока жив процесс, и
# удалить каталог получается не всегда — пусть хотя бы не попадает в git.
.tmp-shots/
.tmp-verify/

# Editor
# Именно **/.vscode/*, а не .vscode/: шаблон с «/» на конце исключает
# сам каталог, а тогда исключение !.vscode/extensions.json во
# frontend/.gitignore перестаёт работать — gitignore не умеет
# раз-игнорировать файл внутри исключённого каталога.
**/.vscode/*
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# SSH
known_hosts

# Локальные dev-инструменты: живут только на машине разработчика
# и переносятся на новое место вручную. В репозитории их нет.
# ВАЖНО: gitignore НЕ действует на уже отслеживаемые файлы —
# если файл успел попасть в индекс, нужен `git rm --cached`.
sync-db.bat
sync-db.example.bat
start-work.bat
end-work.bat
backups/
# docs/ и AGENTS.md — рабочие материалы проекта: документация, инструкции
# для агента, состояние. В репозиторий не идут: он публичный, а разработчик
# один. Резервные копии — на стороне разработчика.
# Когда появится то, что стоит показать наружу, вынесем осознанно.
docs/
AGENTS.md

# Локальные секреты и мусор (cookie-джар curl, дампы ответов и т.п.)
cookies.txt
*.cookies.txt
*.dump
*.sql
*.sql.gz
*.bak

# Ключи и сертификаты — в репозиторий не попадают никогда
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*